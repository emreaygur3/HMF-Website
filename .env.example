# Kendi alan adınız bağlandığında ayarlayın (ör. https://hmfdesenyapi.com).
# Boş bırakılırsa Vercel'in production adresi kullanılır.
NEXT_PUBLIC_SITE_URL=

# İletişim formu e-postaları Gmail üzerinden gönderilir.
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açıkken "Uygulama şifreleri"nden oluşturulan 16 haneli şifre.
GMAIL_APP_PASSWORD=
# (İsteğe bağlı) Gönderen Gmail adresi; boşsa lib/site.ts içindeki e-posta kullanılır.
GMAIL_USER=
# (İsteğe bağlı) Mesajların gideceği adres; boşsa gönderen adrese gelir.
CONTACT_TO_EMAIL=
